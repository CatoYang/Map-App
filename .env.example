# Copy to .env.local (gitignored) and fill in from Supabase → Connect → App Frameworks.
# Both values are public by design; never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Content scripts (npm run content:check / content:standardise / sync): your Obsidian vault.
# From WSL, a Windows folder like C:\Users\You\Documents\Vault is /mnt/c/Users/You/Documents/Vault
CONTENT_DIR="/mnt/c/Users/You/Documents/Obsidian/Your Vault"

# `npm run sync` also needs the SECRET key, which bypasses every access rule.
# Put it in its own gitignored file, .env.sync.local, never here and never in a
# VITE_ variable (those are bundled into the website):
#   SUPABASE_SECRET_KEY=sb_secret_...
