# Copy to .env.local (gitignored) and fill in from Supabase → Connect → App Frameworks.
# Both values are public by design; never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Content scripts (npm run content:check / content:standardise): your Obsidian vault.
# From WSL, a Windows folder like C:\Users\You\Documents\Vault is /mnt/c/Users/You/Documents/Vault
CONTENT_DIR="/mnt/c/Users/You/Documents/Obsidian/Your Vault"
